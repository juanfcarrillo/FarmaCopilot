# Local: ejecutar npm run emulators y copiar este archivo a .env.local.
FIREBASE_PROJECT_ID=demo-farmaenlace
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# Secreto HMAC de desarrollo; reemplazar por aleatorio de >=32 bytes en producción.
CUSTOMER_KEY_SECRET=local-development-only-replace-before-production
APP_BASE_URL=http://localhost:3000
# Producción: QUITAR FIRESTORE_EMULATOR_HOST; proyecto real y secreto propio.
# FIREBASE_CLIENT_EMAIL=cuenta-servicio@proyecto.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternativa local/cloud: GOOGLE_APPLICATION_CREDENTIALS=/ruta/segura/archivo.json
