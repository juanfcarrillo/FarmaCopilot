# Local: ejecutar npm run emulators y copiar este archivo a .env.local.
FIREBASE_PROJECT_ID=demo-farmaenlace
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# Secreto HMAC de desarrollo; reemplazar por aleatorio de >=32 bytes en producción.
CUSTOMER_KEY_SECRET=local-development-only-replace-before-production
APP_BASE_URL=http://localhost:3000
# Teléfono en la misma red: usar http://IP_DEL_EQUIPO:3000 aquí y abrir /pos en ese origen.
# Producción: QUITAR FIRESTORE_EMULATOR_HOST; proyecto real y secreto propio.
# FIREBASE_PROJECT_ID=farma-copilot-2026
# FIREBASE_CLIENT_EMAIL=cuenta-servicio@farma-copilot-2026.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternativa local/cloud: GOOGLE_APPLICATION_CREDENTIALS=/ruta/segura/archivo.json
# Todas estas variables son de servidor. No usar el prefijo NEXT_PUBLIC_.
# Vercel: APP_BASE_URL propio por entorno; no configurar FIRESTORE_EMULATOR_HOST.
# Firestore real confirmado por el usuario en farma-copilot-2026, us-central1.
# Para Vercel usar .env.production.example como referencia; este archivo es para emulador.
# Realtime Database del mismo proyecto existe, pero el MVP no la utiliza.
