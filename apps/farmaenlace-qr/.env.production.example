# Variables de servidor para Vercel. Este archivo no se carga automáticamente.
# Configurarlas en Settings > Environment Variables del proyecto Next.js.
FIREBASE_PROJECT_ID=farma-copilot-2026
FIREBASE_CLIENT_EMAIL=
# Clave PEM privada de la cuenta de servicio; admite saltos reales o \n escapados.
FIREBASE_PRIVATE_KEY=
# Secreto aleatorio propio de >=32 caracteres. Mantener estable para deduplicación.
# Generar, por ejemplo, con: openssl rand -hex 32
CUSTOMER_KEY_SECRET=
# Origen exacto, sin /pos; por ejemplo https://tu-proyecto.vercel.app
APP_BASE_URL=
# No configurar FIRESTORE_EMULATOR_HOST en Vercel.
# No usar el prefijo NEXT_PUBLIC_ para credenciales ni CUSTOMER_KEY_SECRET.
# El firebaseConfig del SDK web no sustituye las credenciales Firebase Admin.
