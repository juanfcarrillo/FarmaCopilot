{
  "name": "farmaenlace-qr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/domain.test.ts",
    "test:integration": "vitest run tests/firestore.test.ts tests/rules.test.ts tests/http.test.ts",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --only firestore --project demo-farmaenlace",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-farmaenlace 'npm run test:integration'"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "firebase-admin": "14.5.0",
    "lucide-react": "^0.577.0",
    "qrcode.react": "^4.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.0",
    "vitest": "^4.0.0",
    "@playwright/test": "1.64.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0"
  },
  "type": "module"
}
