{
  "name": "development-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "harness": "node --import tsx src/cli.ts",
    "harness:validate": "node --import tsx src/cli.ts validate",
    "harness:index": "node --import tsx src/cli.ts sync-index",
    "test:harness": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "gray-matter": "^4.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
